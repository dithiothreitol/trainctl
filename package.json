{
  "name": "trainctl-monorepo",
  "version": "0.5.0",
  "private": true,
  "description": "Running coach in your terminal: training plan as code in a git repo, coach as a tool for your agent (CLI + MCP)",
  "keywords": [
    "running",
    "training-plan",
    "cli",
    "mcp",
    "coach"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "plugin:build": "node tools/plugin/build.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/sync-intervalsicu && tsc --noEmit -p packages/sync-files && tsc --noEmit -p packages/export && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/mcp",
    "check": "pnpm typecheck && pnpm test",
    "trainctl": "node packages/cli/src/bin.ts",
    "release:dry": "pnpm publish -r --dry-run --no-git-checks",
    "build": "pnpm -r run build",
    "simulate:multisport": "node scripts/simulate-multisport.ts",
    "benchmark:multisport": "node scripts/benchmark-multisport.ts",
    "verify:distribution": "node scripts/verify-distribution.ts"
  },
  "devDependencies": {
    "@garmin/fitsdk": "21.218.0",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.1",
    "ical.js": "2.2.1",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  }
}
