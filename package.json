{
  "name": "trainctl-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Coach treningowy w terminalu: plan jako kod, trener jako narzędzie agenta (CLI + MCP)",
  "keywords": [
    "running",
    "training-plan",
    "cli",
    "mcp",
    "coach"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/sync-intervalsicu && tsc --noEmit -p packages/export && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/mcp",
    "check": "pnpm typecheck && pnpm test",
    "trainctl": "node packages/cli/src/bin.ts",
    "release:dry": "pnpm publish -r --dry-run --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
