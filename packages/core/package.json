{
  "name": "trainctl-core",
  "version": "0.1.1",
  "description": "Deterministic running-plan engine: pace zones from race results, macro/microcycles, week re-solver, plan lint",
  "keywords": [
    "running",
    "training-plan",
    "periodization",
    "vdot",
    "sports-science"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
