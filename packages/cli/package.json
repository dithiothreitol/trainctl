{
  "name": "trainctl",
  "version": "0.1.1",
  "description": "Running coach in your terminal: training plan as code in a git repo (init/plan/today/why/reschedule/check)",
  "keywords": [
    "running",
    "training-plan",
    "cli",
    "mcp",
    "intervals-icu",
    "plan-as-code"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "trainctl": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/commands.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/commands.d.ts",
    "exports": {
      ".": {
        "types": "./dist/commands.d.ts",
        "default": "./dist/commands.js"
      }
    },
    "bin": {
      "trainctl": "./dist/bin.js"
    }
  },
  "dependencies": {
    "trainctl-core": "workspace:*",
    "trainctl-export": "workspace:*",
    "trainctl-sync-intervalsicu": "workspace:*",
    "commander": "^14.0.0",
    "yaml": "^2.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
