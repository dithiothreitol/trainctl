{
  "name": "trainctl-mcp",
  "version": "0.5.0",
  "description": "trainctl as MCP tools: a research-backed running coach for Claude Code, Codex and other MCP clients",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "running",
    "training-plan",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "trainctl-mcp": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/server.d.ts",
    "exports": {
      ".": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "bin": {
      "trainctl-mcp": "./dist/bin.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "trainctl": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "trainctl-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
