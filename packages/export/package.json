{
  "name": "trainctl-export",
  "version": "0.1.1",
  "description": "trainctl exports: FIT workouts for the watch, ICS calendar, printable plan and race-day pack",
  "keywords": [
    "fit",
    "garmin",
    "ics",
    "training-plan",
    "export"
  ],
  "license": "MIT",
  "author": "Dariusz Tyszka",
  "homepage": "https://github.com/dithiothreitol/trainctl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dithiothreitol/trainctl.git",
    "directory": "packages/export"
  },
  "bugs": {
    "url": "https://github.com/dithiothreitol/trainctl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "trainctl-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
